# Runtime
NODE_ENV=development
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# CodeLogicX Platform API and Web
PLATFORM_API_PORT=9150
PLATFORM_API_URL=http://127.0.0.1:9150
PLATFORM_WEB_PORT=9160
PLATFORM_WEB_ORIGIN=http://127.0.0.1:9160
PLATFORM_WEB_ORIGINS=
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:9160/status
VITE_PLATFORM_API_URL=http://127.0.0.1:9150
VITE_PLATFORM_WEB_URL=http://127.0.0.1:9160
VITE_MOBILE_WEB_URL=http://127.0.0.1:9160
VITE_MOBILE_API_URL=http://127.0.0.1:9150
VITE_DEV_AUTO_LOGIN=0

# Local development database.
# Container setup replaces these three values in .container/.env from deploy.env.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=codelogicx
DB_PASSWORD=
DB_NAME=codelogicx_db

# Authentication and protected administrator
JWT_SECRET=
CODELOGICX_MODEL_PROVIDER_ENCRYPTION_KEY=

# Optional OpenCode coding-runtime bridge. The bundled OpenCode CLI can serve this endpoint.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@codelogicx.local
INITIAL_ADMIN_PASSWORD=


# CodeLogicX-owned local integrations and storage. Docker overrides the workspace root with
# /srv/codelogicx/repositories, which is the persistent repository volume.
CODELOGICX_WORKSPACE_ROOT=..
CODELOGICX_STORAGE_PATH=./storage/codelogicx
CODELOGICX_SYNC_ROLE=local
CODELOGICX_SYNC_INSTANCE_ID=local-codelogicx
CODELOGICX_SYNC_ENCRYPTION_KEY=
CODELOGICX_SYNC_TOKEN_PEPPER=
# Online codelogicx.codexsun.com runs with CODELOGICX_SYNC_ROLE=cloud. Local installations remain local.

# Agent IDE model gateway. Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
CODEX_EXECUTABLE=bundled
# Optional local-AI services. These values do not replace the Codex runtime.
# Run `npm run local-ai:setup`, review its plan, then rerun with `-Apply` to create
# local Ollama and Qdrant services. Qdrant is for future semantic retrieval;
# MariaDB remains the product metadata and transaction store.
CODELOGICX_LOCAL_AI_ENABLED=0
CODELOGICX_OLLAMA_BASE_URL=http://127.0.0.1:11434
CODELOGICX_OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
CODELOGICX_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CODELOGICX_QDRANT_URL=http://127.0.0.1:6333
CODELOGICX_QDRANT_COLLECTION=codelogicx_project_context
# Primary Codex authentication store. The secondary connector uses connections/secondary below it.
# Docker fixes this root to /var/lib/codelogicx/codex.
CODELOGICX_CODEX_HOME=
# Hostinger VPS MCP. Keep the API token server-side and rotate exposed tokens before use.
HOSTINGER_API_TOKEN=
HOSTINGER_MCP_COMMAND=
HOSTINGER_MCP_PACKAGE=hostinger-api-mcp@1.33.1
# Writable Agent IDE runs use isolated Git worktrees. Docker fixes this to /srv/codelogicx/repositories.
CODELOGICX_AGENT_ALLOWED_ROOTS=
# Docker fixes this to /var/lib/codelogicx/worktrees.
CODELOGICX_AGENT_WORKTREE_ROOT=
# JSON array of shell-free quality gate commands. The built-in default runs git diff --check.
CODELOGICX_AGENT_VERIFICATION_COMMANDS=
# Local commit identity. Agent commits are never pushed automatically.
CODELOGICX_AGENT_GIT_NAME=CodeLogicX
CODELOGICX_AGENT_GIT_EMAIL=codelogicx@localhost

# Telegram support bot. Create the bot with @BotFather. Keep the token server-side.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Notification delivery. MariaDB remains the queue authority when Redis is unavailable.
REDIS_URL=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CodeLogicX

# Central File Manager. Relative paths resolve from the CodeLogicX repository root.
FILE_MANAGER_LOCAL_ROOT=storage
FILE_MANAGER_MAX_UPLOAD_BYTES=26214400

# Container deployment overrides this with the mounted root .env path.
CODELOGICX_ENV_FILE_PATH=

# Destructive database reset remains disabled
CODELOGICX_DB_FRESH_ON_START=0
CODELOGICX_DB_RESET_CONFIRM=
CODELOGICX_ALLOW_PRODUCTION_DB_RESET=0
CODELOGICX_OPENCODE_PATH=
