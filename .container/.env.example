# CodeLogicX production runtime
NODE_ENV=production
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# CodeLogicX Platform API and Web
PLATFORM_API_PORT=9150
PLATFORM_API_URL=http://127.0.0.1:9150
PLATFORM_WEB_PORT=9160
PLATFORM_WEB_ORIGIN=http://127.0.0.1:9160
PLATFORM_WEB_ORIGINS=
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:9160/status
VITE_PLATFORM_API_URL=http://127.0.0.1:9150
VITE_DEV_AUTO_LOGIN=0

# Setup synchronizes DB_USER, DB_PASSWORD, and DB_NAME from deploy.env.
DB_DRIVER=mariadb
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_USER=codelogicx
DB_PASSWORD=generate-with-setup
DB_NAME=codelogicx_db

# Authentication and protected administrator
JWT_SECRET=generate-with-setup
INITIAL_ADMIN_NAME=CodeLogicX Administrator
INITIAL_ADMIN_EMAIL=admin@codelogicx.local
INITIAL_ADMIN_PASSWORD=

# Agent IDE model gateway. Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
CODEX_EXECUTABLE=bundled

# Persistent Git repository storage used by the GitHub Dashboard and Agent IDE.
# Keep both paths aligned with the repository volume in docker-compose.yml.
CODELOGICX_WORKSPACE_ROOT=/srv/codelogicx/repositories
CODELOGICX_AGENT_ALLOWED_ROOTS=/srv/codelogicx/repositories

# Telegram support. TELEGRAM_WEBHOOK_PUBLIC_URL must be public HTTPS.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Existing Redis service. Use a private Docker DNS name when both services share a network.
# Use host.docker.internal only when Redis runs directly on the Linux VPS host.
REDIS_URL=



# Destructive database reset remains disabled
CODELOGICX_DB_FRESH_ON_START=0
CODELOGICX_DB_RESET_CONFIRM=
CODELOGICX_ALLOW_PRODUCTION_DB_RESET=0
