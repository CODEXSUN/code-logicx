# syntax=docker/dockerfile:1.7
ARG NODE_RUNTIME_VERSION=26.5.0
FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS build

ARG NPM_RUNTIME_VERSION=12.0.2
WORKDIR /workspace/codelogicx
RUN npm install --global npm@${NPM_RUNTIME_VERSION}

# CodeLogicX is a self-contained monorepo. Framework and UI are internal workspaces.
COPY . .

RUN --mount=type=cache,id=codelogicx-app-npm,target=/root/.npm \
  npm ci && npm run build

FROM build AS verify
RUN npm run check

FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS api-runtime
ARG NPM_RUNTIME_VERSION=12.0.2
WORKDIR /workspace/codelogicx
RUN npm install --global npm@${NPM_RUNTIME_VERSION} && \
  apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates git gosu openssh-client && \
  rm -rf /var/lib/apt/lists/*
COPY --chown=node:node --from=build /workspace/codelogicx /workspace/codelogicx
COPY --chmod=755 .container/scripts/api-entrypoint.sh /usr/local/bin/codelogicx-api-entrypoint
RUN mkdir -p /var/lib/codelogicx/codex /var/lib/codelogicx/worktrees /srv/codelogicx/repositories && \
  chown -R node:node /workspace/codelogicx /var/lib/codelogicx /srv/codelogicx/repositories
ENV CODELOGICX_CODEX_HOME=/var/lib/codelogicx/codex \
  CODELOGICX_AGENT_ALLOWED_ROOTS=/srv/codelogicx/repositories \
  CODELOGICX_AGENT_WORKTREE_ROOT=/var/lib/codelogicx/worktrees
ENTRYPOINT ["codelogicx-api-entrypoint"]
EXPOSE 9150
CMD ["node", "dist/platform/api/server.js"]

FROM nginx:1.28-alpine AS web-runtime
COPY .container/scripts/nginx-spa.conf /etc/nginx/templates/default.conf.template
COPY --from=build /workspace/codelogicx/dist/platform/web /usr/share/nginx/html
EXPOSE 80
