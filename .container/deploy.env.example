# Docker project and images
CODELOGICX_COMPOSE_PROJECT=codelogicx
CODELOGICX_IMAGE_REGISTRY=codelogicx
CODELOGICX_VERSION=1.0.21
CODELOGICX_IMAGE_TAG=1.0.21
CODELOGICX_MIGRATION_COMPATIBLE_VERSION=1.0.21
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.2
CODELOGICX_BACKUP_RETENTION=10
CODELOGICX_UPDATE_MIN_BACKUP_FREE_MB=1024
CODELOGICX_UPDATE_MIN_DOCKER_FREE_MB=5120

# Docker resources
CODELOGICX_API_CONTAINER_NAME=codelogicx-api
CODELOGICX_WEB_CONTAINER_NAME=codelogicx-web
CODELOGICX_MARIADB_CONTAINER_NAME=codelogicx-mariadb
CODELOGICX_NETWORK=cxapp-network
CODELOGICX_NETWORK_EXTERNAL=true
CODELOGICX_MARIADB_DATA_VOLUME=codelogicx-mariadb-data
CODELOGICX_CODEX_STATE_VOLUME=codelogicx-codex-state
CODELOGICX_AGENT_WORKTREE_VOLUME=codelogicx-agent-worktrees
CODELOGICX_AGENT_REPOSITORY_VOLUME=codelogicx-agent-repositories

# Loopback publishing
CODELOGICX_BIND_ADDRESS=127.0.0.1
CODELOGICX_API_INTERNAL_PORT=9150
CODELOGICX_API_HOST_PORT=9150
CODELOGICX_WEB_HOST_PORT=9160

# Telegram support runtime values are copied to the root .env used by the API.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Standalone MariaDB infrastructure
MARIADB_IMAGE=mariadb:11.8
MARIADB_ROOT_PASSWORD=generate-with-setup
DB_USER=codelogicx
DB_PASSWORD=generate-with-setup
DB_NAME=codelogicx_db

# Reuse CXApp-owned MariaDB infrastructure while keeping the CodeLogicX database separate.
CODELOGICX_SHARED_MARIADB_CONTAINER_NAME=cxapp-mariadb
CODELOGICX_SHARED_MARIADB_ENV_FILE=../../cxapp/.container/deploy.env
CODELOGICX_SHARED_MARIADB_ROOT_PASSWORD=

# Redis is not created by this Compose file. Put its authenticated URL in the root .env file.
# The API can reach a Redis container by its service name on CODELOGICX_NETWORK.
# The API can reach a host Redis service through host.docker.internal.
