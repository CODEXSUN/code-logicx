{
  "name": "@codelogicx/mobile",
  "version": "1.0.93",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "python tools/generate-brand-assets.py",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --host 127.0.0.1 --port 9170",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "sync": "npm run build && cap sync android",
    "apk:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "run:android": "cap run android",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^9.0.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "ionicons": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
